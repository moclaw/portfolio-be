# Application
PORT=8080
HOST=0.0.0.0
GIN_MODE=release
ENVIRONMENT=development

# Database Configuration
# Options: "postgres" or "sqlite"
DATABASE_TYPE=postgres
# For PostgreSQL (change credentials in production!):
DATABASE_URL=postgres://portfolio:changeme@postgres:5432/portfolio_db?sslmode=disable
# For SQLite (uncomment if using SQLite):
# DATABASE_TYPE=sqlite
# DATABASE_URL=portfolio.db

# Redis Configuration
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# AWS/LocalStack S3 Configuration
# IMPORTANT: Change these values in production!
AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=us-east-1
# Generate secure keys: openssl rand -hex 20
S3_ACCESS_KEY_ID=changeme-generate-secure-key
S3_SECRET_ACCESS_KEY=changeme-generate-secure-secret
S3_ENDPOINT=http://localstack:4566
S3_BUCKET=portfolio-uploads
S3_REGION=us-east-1
# Public URL for serving uploaded files (CDN or proxy URL)
S3_PUBLIC_URL=https://media.moclawr.com

# JWT Configuration (CHANGE IN PRODUCTION!)
JWT_SECRET=changeme-use-strong-secret-in-production
JWT_SECRET_KEY=changeme-use-strong-secret-in-production
JWT_ISSUER=portfolio-api

# Secrets Manager (set to false for local development)
USE_SECRETS_MANAGER=false
SECRET_NAME=portfolio-secrets
